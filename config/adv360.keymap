#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

#define ______ &trans
#define xxxxxx &none

&lt {
  retro-tap;
};

&sl {
    release-after-ms = <1000>;
};

/ {

    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      KP_NZS: mm_KP_N0_space_behavior {
          compatible = "zmk,behavior-mod-morph";
          label = "KP_NZS";
          bindings = <&kp KP_N0>, <&kp SPACE>;
          #binding-cells = <0>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
          keep-mods = <(MOD_LSFT|MOD_RSFT)>;
      };
    };

    combos {
      compatible = "zmk,combos";
      combo_caps_word {
          timeout-ms = <25>;
	  key-positions = <23 41>;
	  bindings = <&sl 3>;
      };
      combo_sca {
          timeout-ms = <25>;
	  key-positions = <18 32>;
	  bindings = <&sl 3>;
      };
    };

    macros {

      sca: sca {
          compatible = "zmk,behavior-macro-one-param";
	  #binding-cells = <1>;
	  wait-ms = <20>;
	  tap-ms = <20>;
	  bindings
            = <&macro_press &kp LSHFT>
	    , <&macro_press &kp LCTRL>
	    , <&macro_press &kp LALT>
	    , <&macro_param_1to1>
            , <&macro_tap &kp MACRO_PLACEHOLDER>
	    , <&macro_release &kp LALT>
	    , <&macro_release &kp LCTRL>
            , <&macro_release &kp LSHFT>
            ;
      };

    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
 &kp EQUAL    &kp N1      &kp N2     &kp N3      &kp N4       &kp N5   &tog 1                                                   &mo 4      &kp N6   &kp N7      &kp N8        &kp N9         &kp N0           &kp MINUS
 &kp TAB      &kp Q       &kp W      &kp E       &kp R        &kp T    &kp PSCRN                                                &kp INS    &kp Y    &kp U       &kp I         &kp O          &kp P            &kp BSLH
 &kp ESC      &kp A       &kp S      &kp D       &kp F        &kp G    xxxxxx     &kp LCTRL  &kp LALT     &kp LGUI   &kp RCTRL  xxxxxx     &kp H    &kp J       &kp K         &kp L          &kp SEMI         &kp SQT
 &kp LSHFT    &kp Z       &kp X      &kp C       &kp V        &kp B                          &kp HOME     &kp PG_UP                        &kp N    &kp M       &kp COMMA     &kp DOT        &kp FSLH         &kp RSHFT
 &mo 2        &kp GRAVE   &kp CAPS   &kp LEFT    &kp RIGHT             &kp BSPC   &kp DEL    &kp END      &kp PG_DN  &kp ENTER  &kp SPACE           &kp UP      &kp DOWN      &kp LBKT       &kp RBKT         &mo 2
      >;
    };

    keypad {
      display-name = "Kp";
      bindings = <
 ______       ______      ______     ______      ______       ______   ______                                                   ______     ______   &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  ______
 ______       ______      ______     &kp UP      ______       ______   ______                                                   ______     ______   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     ______
 ______       ______      &kp LEFT   &kp DOWN    &kp RIGHT    ______   ______     ______     ______       ______     ______     ______     ______   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      ______
 ______       ______      ______     ______      ______       ______                         ______       ______                           ______   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     ______
 ______       ______      ______     ______      ______                ______     ______     ______       ______     ______     &KP_NZS             ______      ______        &kp KP_DOT     ______           ______
      >;
    };

    fn {
      display-name = "Fn";
      bindings = <
 &kp F1       &kp F2      &kp F3     &kp F4      &kp F5       &kp F6   ______                                                   ______     &kp F7   &kp F8      &kp F9        &kp F10        &kp F11          &kp F12
 &kp F13      &kp F14     &kp F15    &kp F16     &kp F17      &kp F18  ______                                                   ______     &kp F19  &kp F20     &kp F21       &kp F22        &kp F23          &kp F24
 &kp K_CMENU  &tog 1      &tog 1     &tog 1      &tog 1       &tog 1   ______     ______     ______       ______     ______     ______     &tog 1   &tog 1      &tog 1        &tog 1         &tog 1           &tog 1
 ______       ______      &kp K_CUT  &kp K_COPY  &kp K_PASTE  ______                         ______       ______                           ______   ______      ______        ______         ______           ______
 ______       ______      ______     &kp HOME    &kp END               &kp SPACE  &kp ENTER  ______       ______     ______     ______              &kp PG_UP   &kp PG_DN     ______         ______           ______
      >;
    };

    sca {
      display-name = "Shift-Ctrl-Alt";
      bindings = <
 &sca EQUAL   &sca N1     &sca N2    &sca N3     &sca N4      &sca N5  ______                                                   ______     &sca N6  &sca N7     &sca N8       &sca N9        &sca N0          &sca MINUS
 &sca TAB     &sca Q      &sca W     &sca E      &sca R       &sca T   ______                                                   ______     &sca Y   &sca U      &sca I        &sca O         &sca P           &sca BSLH
 &sca ESC     &sca A      &sca S     &sca D      &sca F       &sca G   ______     ______     ______       ______     ______     ______     &sca H   &sca J      &sca K        &sca L         &sca SEMI        &sca SQT
 ______       &sca Z      &sca X     &sca C      &sca V       &sca B                         &sca HOME    &sca PG_UP                       &sca N   &sca M      &sca COMMA    &sca DOT       &sca FSLH        ______
 ______       &sca GRAVE  ______     &sca LEFT   &sca RIGHT            &sca BSPC  &sca DEL   &sca END     &sca PG_DN &sca ENTER &sca SPACE          &sca UP     &sca DOWN     &sca LBKT      &sca RBKT        ______
      >;
    };

    mod {
      display-name = "Mod";
      bindings = <
 xxxxxx  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  xxxxxx                                                                         ______                  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  xxxxxx
 xxxxxx  xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx        &bootloader                                                                    &bootloader             xxxxxx           xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx
 xxxxxx  xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx        &rgb_ug RGB_MEFS_CMD 5  &bt BT_CLR  &bt BT_CLR        &bt BT_CLR  &bt BT_CLR   &rgb_ug RGB_MEFS_CMD 5  xxxxxx           xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx
 xxxxxx  xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx                                            xxxxxx            xxxxxx                                           xxxxxx           xxxxxx        xxxxxx        xxxxxx        xxxxxx        xxxxxx
 xxxxxx  xxxxxx        xxxxxx        &bl BL_INC    &bl BL_DEC                  &rgb_ug RGB_TOG         &bl BL_TOG  xxxxxx            xxxxxx      &bl BL_TOG   &rgb_ug RGB_TOG                          &bl BL_INC    &bl BL_DEC    xxxxxx        xxxxxx        xxxxxx
      >;
    };

    extra1 {
      display-name = "Red";
      status = "reserved";
    };

    extra2 {
      display-name = "Purple";
      status = "reserved";
    };

    extra3 {
      display-name = "Cyan";
      status = "reserved";
    };

    extra4 {
      display-name = "Yellow";
      status = "reserved";
    };
  };
};
